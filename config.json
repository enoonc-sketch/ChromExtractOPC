  "csv_export_dir": "谱图导出",
  "log_file": "logs/server.log",
  "max_points": 20000,
  "allow_anonymous": true,
  "users": {},
  "allow_insecure_fallback": false,
  "trusted_client_certs_dir": "certs/trusted",
  "remote_export": true,
  "export_min_interval_sec": 10,
  "max_connections": 20,
  "max_trace_points": 2000000,
  "max_file_mb": 256,
  "log_max_mb": 5,
  "log_backups": 5,
  "web_ui": true,
  "web_host": "127.0.0.1",
  "web_port": 8840,
  "web_https": "auto",
  "web_cert_file": "",
  "web_key_file": "",
  "alert_stale_minutes": 120,
  "alert_scan_errors": 3,
  "alert_webhook": "",
  "alert_email_to": "",
  "smtp_host": "",
  "smtp_port": 465,
  "smtp_security": "ssl",
  "smtp_user": "",
  "smtp_from": "",
  "alert_webhook_level": "all",
  "alert_email_level": "critical",
  "alert_channel_rules": [],
  "alert_probes": [],
  "env_check_on_start": true,
  "env_check_hours": 6,
  "allow_test_send": true,
  "test_send_min_interval_sec": 5,
  "transmission_stale_sec": 7200
}
